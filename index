<script>
/* ══ STARS ══ */
(()=>{
  const c=document.getElementById('stars'),ctx=c.getContext('2d');
  let W,H,stars=[];
  function resize(){W=c.width=innerWidth;H=c.height=innerHeight;make();}
  function make(){stars=[];for(let i=0;i<200;i++)stars.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*.9+.2,a:Math.random(),da:(Math.random()-.5)*.004,vx:(Math.random()-.5)*.06,vy:(Math.random()-.5)*.06});}
  function draw(){
    ctx.clearRect(0,0,W,H);
    stars.forEach(s=>{
      s.a+=s.da;if(s.a<=0||s.a>=1)s.da*=-1;
      s.x+=s.vx;s.y+=s.vy;
      if(s.x<0)s.x=W;if(s.x>W)s.x=0;if(s.y<0)s.y=H;if(s.y>H)s.y=0;
      ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle=`rgba(200,190,255,${s.a*.55})`;ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',resize);resize();draw();
})();

/* ══ PC: CUSTOM CURSOR + TRAIL ══ */
const isPC=window.matchMedia('(hover:hover) and (pointer:fine)').matches;
if(isPC){
  const cur=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
  let mx=0,my=0,rx=0,ry=0;
  const trail=[];const TRAIL_LEN=12;
  for(let i=0;i<TRAIL_LEN;i++){
    const d=document.createElement('div');
    d.className='trail-dot';
    const sz=Math.round(8*(1-i/TRAIL_LEN));
    d.style.cssText=`width:${sz}px;height:${sz}px;opacity:${(1-i/TRAIL_LEN)*.4};background:var(--p2);`;
    document.body.appendChild(d);
    trail.push({el:d,x:0,y:0});
  }
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
  (function animRing(){
    rx+=(mx-rx)*.12;ry+=(my-ry)*.12;
    ring.style.left=rx+'px';ring.style.top=ry+'px';
    for(let i=trail.length-1;i>0;i--){trail[i].x+=(trail[i-1].x-trail[i].x)*.35;trail[i].y+=(trail[i-1].y-trail[i].y)*.35;trail[i].el.style.left=trail[i].x+'px';trail[i].el.style.top=trail[i].y+'px';}
    trail[0].x+=(mx-trail[0].x)*.35;trail[0].y+=(my-trail[0].y)*.35;trail[0].el.style.left=trail[0].x+'px';trail[0].el.style.top=trail[0].y+'px';
    requestAnimationFrame(animRing);
  })();
  document.querySelectorAll('a,.badge,.skill-chip,.link-item,.stat,.fun-item').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.style.transform='translate(-50%,-50%) scale(2.2)';ring.style.width='52px';ring.style.height='52px';ring.style.borderColor='rgba(168,85,247,.75)';});
    el.addEventListener('mouseleave',()=>{cur.style.transform='translate(-50%,-50%) scale(1)';ring.style.width='34px';ring.style.height='34px';ring.style.borderColor='rgba(168,85,247,.5)';});
  });
}

/* ══ PC: CLICK SPARKS ══ */
function clickSpark(e){
  const x=e.clientX,y=e.clientY;
  const colors=['#A855F7','#06B6D4','#EC4899','#F59E0B','#10B981'];
  for(let i=0;i<12;i++){
    const p=document.createElement('div');
    p.className='click-particle';
    const ang=Math.random()*Math.PI*2,dist=30+Math.random()*60,sz=3+Math.random()*5;
    p.style.cssText=`left:${x}px;top:${y}px;width:${sz}px;height:${sz}px;background:${colors[Math.floor(Math.random()*colors.length)]};`;
    document.body.appendChild(p);
    const tx=Math.cos(ang)*dist,ty=Math.sin(ang)*dist;
    p.animate([{transform:'translate(-50%,-50%) scale(1)',opacity:1},{transform:`translate(calc(-50% + ${tx}px),calc(-50% + ${ty}px)) scale(0)`,opacity:0}],{duration:500+Math.random()*300,easing:'cubic-bezier(.16,1,.3,1)',fill:'forwards'}).onfinish=()=>p.remove();
  }
}
if(isPC) document.addEventListener('click',clickSpark);

/* ══ PC: CARD SPOTLIGHT ══ */
document.querySelectorAll('.card').forEach(card=>{
  card.addEventListener('mousemove',e=>{const r=card.getBoundingClientRect();card.style.setProperty('--mx',e.clientX-r.left+'px');card.style.setProperty('--my',e.clientY-r.top+'px');});
});

/* ══ PC: KONAMI CODE ══ */
const KONAMI=[38,38,40,40,37,39,37,39,66,65];let kpos=0;
document.addEventListener('keydown',e=>{
  if(e.keyCode===KONAMI[kpos]){kpos++;if(kpos===KONAMI.length){kpos=0;triggerKonami();}}else{kpos=0;}
});
function triggerKonami(){
  document.body.classList.add('glitching');
  showToast('🕹️ KONAMI! You found the secret!');
  setTimeout(()=>document.body.classList.remove('glitching'),2000);
  for(let i=0;i<30;i++) setTimeout(()=>clickSpark({clientX:Math.random()*innerWidth,clientY:Math.random()*innerHeight}),i*60);
}
function showKonamiHint(){showToast('Try: ↑↑↓↓←→←→BA on your keyboard!');}

/* ══ PC: T KEY THEME ══ */
const themes=['','theme-fire','theme-ocean','theme-forest','theme-rose'];
const themeNames=['Default','🔥 Fire','🌊 Ocean','🌿 Forest','🌸 Rose'];
let themeIdx=0;
function cycleTheme(){
  themeIdx=(themeIdx+1)%themes.length;
  document.body.className=themes[themeIdx];
  showToast(`${themeNames[themeIdx]} theme activated`);
}
document.addEventListener('keydown',e=>{if(e.key==='t'||e.key==='T'){const tag=document.activeElement.tagName;if(tag!=='INPUT'&&tag!=='TEXTAREA')cycleTheme();}});

/* ══ TOAST ══ */
let toastTimer;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),3000);
}

/* ══ MOBILE: TAP RIPPLE ══ */
if(!isPC){
  document.addEventListener('touchstart',e=>{
    const touch=e.touches[0];
    const el=e.target.closest('.card');
    if(!el)return;
    const r=el.getBoundingClientRect();
    const rip=document.createElement('div');
    rip.className='ripple';
    rip.style.cssText=`left:${touch.clientX-r.left}px;top:${touch.clientY-r.top}px;width:80px;height:80px;margin-left:-40px;margin-top:-40px;`;
    el.appendChild(rip);
    setTimeout(()=>rip.remove(),700);
  },{passive:true});
}

/* ══ MOBILE: GYRO PARALLAX ══ */
if(!isPC && window.DeviceOrientationEvent){
  const page=document.querySelector('.page');
  let permAsked=false;
  function enableGyro(){
    window.addEventListener('deviceorientation',e=>{
      const x=Math.max(-15,Math.min(15,e.gamma||0));
      const y=Math.max(-10,Math.min(10,(e.beta||0)-45));
      page.style.transform=`perspective(800px) rotateY(${x*.08}deg) rotateX(${-y*.06}deg)`;
      document.querySelectorAll('.blob').forEach((b,i)=>{
        b.style.transform=`translate(${x*(i+1)*1.5}px,${y*(i+1)*1.2}px)`;
      });
    },{passive:true});
    document.getElementById('tiltHint').querySelector('.fun-label').textContent='Tilt to tilt the page!';
  }
  if(typeof DeviceOrientationEvent.requestPermission==='function'){
    document.getElementById('tiltHint').style.cursor='pointer';
    document.getElementById('tiltHint').addEventListener('click',()=>{
      if(permAsked)return;permAsked=true;
      DeviceOrientationEvent.requestPermission().then(s=>{if(s==='granted')enableGyro();});
    });
  } else {
    enableGyro();
  }
}

/* ══ MOBILE: SHAKE TO THEME ══ */
if(!isPC){
  let lastAcc={x:0,y:0,z:0},lastShake=0;
  function triggerShake(){cycleTheme();}
  window.addEventListener('devicemotion',e=>{
    const a=e.accelerationIncludingGravity;if(!a)return;
    const dx=Math.abs(a.x-lastAcc.x),dy=Math.abs(a.y-lastAcc.y),dz=Math.abs(a.z-lastAcc.z);
    lastAcc={x:a.x,y:a.y,z:a.z};
    if(dx+dy+dz>30 && Date.now()-lastShake>1500){lastShake=Date.now();cycleTheme();}
  },{passive:true});
}

/* ══ MOBILE: LONG PRESS AVATAR ══ */
let lpTimer;
const heroAv=document.getElementById('heroAvatar');
heroAv.addEventListener('touchstart',()=>{lpTimer=setTimeout(doLongPressEgg,800);},{passive:true});
heroAv.addEventListener('touchend',()=>clearTimeout(lpTimer),{passive:true});
function doLongPressEgg(){
  const eggs=['🥚 You found a secret!','👀 stop poking me','🦆 quack','✨ hydro was here','🔮 skill issue','🎯 nerd detected'];
  showToast(eggs[Math.floor(Math.random()*eggs.length)]);
  heroAv.style.animation='spin 0.4s ease';
  setTimeout(()=>heroAv.style.animation='',400);
}

/* ══ TYPING ══ */
(()=>{
  const lines=['developer & builder.','shipping things that matter.','always building something new.','making the web cooler.'];
  let li=0,ci=0,del=false;
  const el=document.getElementById('typeText');
  function tick(){
    const cur=lines[li];
    if(!del){ci++;el.textContent=cur.slice(0,ci);if(ci===cur.length){del=true;setTimeout(tick,1900);return;}setTimeout(tick,55);}
    else{ci--;el.textContent=cur.slice(0,ci);if(ci===0){del=false;li=(li+1)%lines.length;}setTimeout(tick,28);}
  }
  tick();
})();

/* ══ COUNT UP ══ */
document.querySelectorAll('.count-up').forEach(el=>{
  const t=+el.dataset.target;let c=0;
  const iv=setInterval(()=>{c+=Math.ceil(t/30);if(c>=t){c=t;clearInterval(iv);}el.textContent=c;},40);
});

/* ══ VISITOR COUNT (session-based fun) ══ */
(()=>{
  const key='hv_count';let n=parseInt(sessionStorage.getItem(key)||'0')+1;
  sessionStorage.setItem(key,n);
  // show a fun number, local + random offset for realism
  document.getElementById('visitCount').textContent=(1200+n*7).toLocaleString();
})();

/* ══ LANYARD ══ */
const UID='582502664252686356';
const SC={online:'#10B981',idle:'#F59E0B',dnd:'#EF4444',offline:'#6B7280'};
const SL={online:'Online',idle:'Idle',dnd:'Do not disturb',offline:'Offline'};
function setBadgeClass(el,s){el.className='dc-status-badge badge '+(s==='online'?'b-green':s==='dnd'?'b-purple':'b-amber');}
async function fetchPresence(){
  try{
    const d=(await(await fetch(`https://api.lanyard.rest/v1/users/${UID}`)).json()).data;
    if(!d)return;
    const u=d.discord_user;
    const ext=u.avatar?.startsWith('a_')?'gif':'png';
    const av=u.avatar?`https://cdn.discordapp.com/avatars/${u.id}/${u.avatar}.${ext}?size=256`:'https://cdn.discordapp.com/embed/avatars/0.png';
    document.getElementById('dcAvatar').src=av;document.getElementById('heroAvatar').src=av;
    const col=SC[d.discord_status]||SC.offline;
    document.getElementById('dcDot').style.cssText+=`background:${col};box-shadow:0 0 10px ${col};`;
    document.getElementById('heroRing').style.cssText+=`background:${col};box-shadow:0 0 14px ${col};`;
    const sl=SL[d.discord_status]||'Offline';
    const badge=document.getElementById('dcBadge');
    badge.textContent=sl;setBadgeClass(badge,d.discord_status);
    document.getElementById('statusHeroBadge').textContent=sl;
    document.getElementById('dcDot').classList.toggle('online-pulse',d.discord_status==='online');
    const actText=document.getElementById('dcActText'),actAlbum=document.getElementById('dcActAlbum'),actAlbumImg=document.getElementById('dcActAlbumImg');
    const albumHero=document.getElementById('dcAlbumHero'),albumHeroImg=document.getElementById('dcAlbumHeroImg');
    const spProg=document.getElementById('spProgress'),spBar=document.getElementById('spBar');
    actAlbum.style.display='none';albumHero.style.display='none';spProg.style.display='none';
    if(d.listening_to_spotify&&d.spotify){
      const sp=d.spotify;
      actAlbum.style.display='block';actAlbumImg.src=sp.album_art_url;
      albumHero.style.display='block';albumHeroImg.src=sp.album_art_url;
      actText.innerHTML=`🎵 <em>${sp.song}</em> · ${sp.artist}`;
      badge.textContent='Spotify';setBadgeClass(badge,'online');
      if(sp.timestamps){const pct=Math.min(100,Math.round(((Date.now()-sp.timestamps.start)/(sp.timestamps.end-sp.timestamps.start))*100));spProg.style.display='block';spBar.style.width=pct+'%';}
      return;
    }
    const game=d.activities?.find(a=>a.type===0);
    const custom=d.activities?.find(a=>a.type===4);
    if(game){actText.innerHTML=`🎮 Playing <em>${game.name}</em>${game.details?` · ${game.details}`:''}`;badge.textContent='Playing';setBadgeClass(badge,'online');}
    else if(custom?.state){actText.innerHTML=`${custom.emoji?.name||'💬'} <em>${custom.state}</em>`;}
    else{actText.innerHTML=`💬 Online on Discord`;}
  }catch(e){console.warn('Lanyard',e);}
}
fetchPresence();setInterval(fetchPresence,12000);
