<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>hydrø</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Syne:wght@400;700;800;900&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07070d;--bg2:#0f0f1a;--bg3:#13131f;
  --p:#7C3AED;--p2:#A855F7;--p3:#C084FC;
  --c:#06B6D4;--c2:#22D3EE;
  --g:#10B981;
  --tx:#F4F4F5;--tx2:#A1A1AA;--tx3:#52525B;
  --border:rgba(255,255,255,0.055);--border-h:rgba(168,85,247,0.4);
  --r:16px;--r-sm:10px;
  --theme-a:#7C3AED;--theme-b:#06B6D4;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--tx);font-family:'Space Grotesk',sans-serif;min-height:100vh;overflow-x:hidden;cursor:none;}
@media(hover:none){body{cursor:auto;}}

/* CANVAS */
#stars{position:fixed;inset:0;z-index:0;pointer-events:none;}

/* CUSTOM CURSOR - PC only */
.cursor,.cursor-ring{display:none;}
@media(hover:hover) and (pointer:fine){
  .cursor{display:block;position:fixed;width:10px;height:10px;border-radius:50%;background:var(--p2);pointer-events:none;z-index:9999;mix-blend-mode:screen;transform:translate(-50%,-50%);transition:transform .12s,background .2s,width .15s,height .15s;}
  .cursor-ring{display:block;position:fixed;width:34px;height:34px;border-radius:50%;border:1px solid rgba(168,85,247,.5);pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .2s,height .2s,border-color .2s;}
}

/* CURSOR TRAIL */
.trail-dot{position:fixed;border-radius:50%;pointer-events:none;z-index:9990;mix-blend-mode:screen;transform:translate(-50%,-50%);}

/* CLICK PARTICLE */
.click-particle{position:fixed;pointer-events:none;z-index:9995;border-radius:50%;transform:translate(-50%,-50%);}

/* NOISE */
.noise{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");}

/* BLOBS */
.blobs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.blob{position:absolute;border-radius:50%;filter:blur(100px);animation:drift 18s ease-in-out infinite;}
.b1{width:600px;height:600px;background:rgba(124,58,237,.18);top:-200px;left:-150px;animation-delay:0s;}
.b2{width:500px;height:500px;background:rgba(6,182,212,.13);bottom:-150px;right:-100px;animation-delay:-6s;}
.b3{width:350px;height:350px;background:rgba(168,85,247,.12);top:40%;left:55%;transform:translate(-50%,-50%);animation-delay:-12s;}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1);}33%{transform:translate(30px,-40px) scale(1.05);}66%{transform:translate(-20px,25px) scale(.97);}}

/* SCANLINE */
.scanline{position:fixed;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,.03) 3px,rgba(0,0,0,.03) 4px);}

/* KONAMI / TOAST */
.toast{
  position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(80px);
  background:rgba(13,13,22,.95);border:1px solid rgba(168,85,247,.4);
  border-radius:999px;padding:.55rem 1.2rem;font-size:.8rem;color:var(--tx);
  z-index:10000;transition:transform .4s cubic-bezier(.16,1,.3,1),opacity .4s;opacity:0;
  backdrop-filter:blur(20px);white-space:nowrap;
}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1;}

/* KEYBOARD HINTS - PC only */
.kb-hints{display:none;}
@media(hover:hover) and (pointer:fine){
  .kb-hints{
    display:flex;gap:.5rem;align-items:center;justify-content:center;
    font-size:.65rem;color:var(--tx3);padding:.5rem 0 0;flex-wrap:wrap;
  }
  .kb-key{
    display:inline-flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,.05);border:1px solid var(--border);
    border-radius:5px;padding:.1rem .4rem;font-size:.62rem;color:var(--tx3);
    font-family:monospace;letter-spacing:0;
  }
}

/* MOBILE HINT */
.mobile-hint{display:none;text-align:center;font-size:.7rem;color:var(--tx3);padding:.4rem 0 0;}
@media(hover:none){.mobile-hint{display:block;}}

/* TILT CARD - mobile */
@media(hover:none){
  .card{transition:transform .1s ease,border-color .3s,box-shadow .3s !important;}
}

/* RIPPLE */
.ripple{position:absolute;border-radius:50%;background:rgba(168,85,247,.25);transform:scale(0);animation:rippleOut .6s ease-out forwards;pointer-events:none;}
@keyframes rippleOut{to{transform:scale(4);opacity:0;}}

/* PAGE */
.page{position:relative;z-index:2;max-width:660px;margin:0 auto;padding:3.5rem 1.25rem 5rem;display:flex;flex-direction:column;gap:.85rem;opacity:0;animation:pageIn .9s .2s cubic-bezier(.16,1,.3,1) forwards;}
@keyframes pageIn{to{opacity:1;}}

/* CARD */
.card{background:rgba(13,13,22,.7);border:1px solid var(--border);border-radius:var(--r);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);overflow:hidden;position:relative;transition:border-color .3s,box-shadow .3s,transform .3s;animation:cardIn .7s cubic-bezier(.16,1,.3,1) both;}
.card:nth-child(1){animation-delay:.1s}.card:nth-child(2){animation-delay:.18s}.card:nth-child(3){animation-delay:.26s}.card:nth-child(4){animation-delay:.34s}.card:nth-child(5){animation-delay:.42s}.card:nth-child(6){animation-delay:.5s}.card:nth-child(7){animation-delay:.58s}
@keyframes cardIn{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
.card::before{content:'';position:absolute;inset:0;border-radius:var(--r);background:radial-gradient(600px circle at var(--mx,50%) var(--my,50%),rgba(168,85,247,.05),transparent 40%);pointer-events:none;transition:opacity .3s;opacity:0;}
.card:hover::before{opacity:1;}
.card:hover{border-color:rgba(168,85,247,.22);box-shadow:0 0 40px rgba(124,58,237,.1),0 8px 32px rgba(0,0,0,.4);}
.card::after{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(168,85,247,.5),rgba(6,182,212,.4),transparent);opacity:0;transition:opacity .3s;border-radius:1px;}
.card:hover::after{opacity:1;}

/* HERO */
.type-strip{padding:.7rem 1.5rem;border-bottom:1px solid var(--border);font-size:.82rem;color:var(--tx2);display:flex;align-items:center;gap:.5rem;}
.type-cursor{display:inline-block;width:2px;height:.9em;background:var(--p2);animation:blink .7s infinite;vertical-align:middle;border-radius:1px;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
.hero-body{padding:1.5rem 1.5rem 1.75rem;display:grid;grid-template-columns:auto 1fr;gap:1.4rem;align-items:center;}
.avatar-wrap{position:relative;width:88px;height:88px;flex-shrink:0;}
.avatar-ring{position:absolute;inset:-4px;border-radius:50%;background:conic-gradient(from 0deg,#7C3AED,#06B6D4,#A855F7,#EC4899,#7C3AED);animation:spin 5s linear infinite;}
.avatar-ring-2{position:absolute;inset:-8px;border-radius:50%;background:conic-gradient(from 180deg,rgba(124,58,237,.3),rgba(6,182,212,.3),rgba(168,85,247,.3),rgba(124,58,237,.3));animation:spin 9s linear infinite reverse;}
@keyframes spin{to{transform:rotate(360deg)}}
.avatar-mask{position:absolute;inset:3px;border-radius:50%;background:var(--bg);z-index:1;}
.avatar-wrap img{position:absolute;inset:4px;border-radius:50%;object-fit:cover;z-index:2;width:calc(100% - 8px);height:calc(100% - 8px);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.avatar-wrap:hover img{transform:scale(1.06);}
.status-dot{position:absolute;bottom:4px;right:4px;z-index:3;width:17px;height:17px;border-radius:50%;border:3px solid var(--bg);transition:background .4s;box-shadow:0 0 12px var(--g);}
.hero-name{font-family:'Syne',sans-serif;font-size:2rem;font-weight:900;line-height:1;letter-spacing:-.03em;background:linear-gradient(135deg,#fff 30%,var(--p3) 70%,var(--c2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmerText 4s ease-in-out infinite;background-size:200% auto;}
@keyframes shimmerText{0%,100%{background-position:0%}50%{background-position:100%}}
.hero-handle{font-size:.8rem;color:var(--tx3);margin-top:.25rem;}
.hero-badges{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.6rem;}
.badge{display:inline-flex;align-items:center;gap:4px;font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.2rem .6rem;border-radius:999px;border:1px solid;transition:transform .2s,box-shadow .2s;cursor:default;}
.badge:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.3);}
.b-purple{background:rgba(124,58,237,.18);border-color:rgba(168,85,247,.4);color:#C4B5FD;}
.b-cyan{background:rgba(6,182,212,.12);border-color:rgba(6,182,212,.35);color:#67E8F9;}
.b-green{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.35);color:#6EE7B7;}
.b-amber{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.35);color:#FCD34D;}
.b-pink{background:rgba(236,72,153,.12);border-color:rgba(236,72,153,.35);color:#F9A8D4;}
.b-red{background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.35);color:#FCA5A5;}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);}
.stat{background:rgba(13,13,22,.95);padding:1rem .75rem;text-align:center;position:relative;overflow:hidden;transition:background .2s;cursor:default;}
.stat:hover{background:rgba(124,58,237,.08);}
.stat::before{content:'';position:absolute;inset:0;background:radial-gradient(80px circle at 50% 100%,rgba(168,85,247,.15),transparent);opacity:0;transition:opacity .3s;}
.stat:hover::before{opacity:1;}
.stat-num{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:900;line-height:1;}
.stat-label{font-size:.63rem;color:var(--tx3);text-transform:uppercase;letter-spacing:.1em;margin-top:3px;}

/* FUN CARD */
.fun-card-inner{padding:1.1rem 1.4rem;}
.sec-label{font-size:.63rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--tx3);margin-bottom:.75rem;display:flex;align-items:center;gap:.5rem;}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border);}
.fun-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;}
.fun-item{
  background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:var(--r-sm);
  padding:.75rem .9rem;display:flex;align-items:center;gap:.65rem;
  font-size:.8rem;color:var(--tx2);transition:all .2s;cursor:default;position:relative;overflow:hidden;
}
.fun-item::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(6,182,212,.05));opacity:0;transition:opacity .2s;}
.fun-item:hover{border-color:rgba(168,85,247,.3);color:var(--tx);transform:translateY(-1px);}
.fun-item:hover::before{opacity:1;}
.fun-icon{font-size:1.1rem;flex-shrink:0;line-height:1;}
.fun-text{line-height:1.3;}
.fun-label{font-size:.7rem;color:var(--tx3);margin-top:1px;}
/* PC-only items */
.pc-only{display:none;}
@media(hover:hover) and (pointer:fine){.pc-only{display:flex;}.mobile-only{display:none !important;}}

/* ABOUT */
.about-inner{padding:1.25rem 1.4rem;}
.about-text{font-size:.86rem;color:var(--tx2);line-height:1.8;}
.about-text span{color:var(--tx);font-weight:500;}

/* SKILLS */
.skills-inner{padding:1.1rem 1.4rem;}
.skills-list{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.75rem;}
.skill-chip{font-size:.72rem;font-weight:600;letter-spacing:.02em;padding:.3rem .75rem;border-radius:8px;border:1px solid var(--border);color:var(--tx2);background:rgba(255,255,255,.03);transition:all .2s;position:relative;overflow:hidden;cursor:default;}
.skill-chip::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--p),var(--c));opacity:0;transition:opacity .2s;}
.skill-chip span{position:relative;z-index:1;}
.skill-chip:hover{color:var(--tx);border-color:rgba(168,85,247,.4);transform:translateY(-1px);}
.skill-chip:hover::before{opacity:.15;}

/* DISCORD */
.dc-inner{padding:1.1rem 1.25rem;}
.dc-top{display:flex;align-items:center;gap:.9rem;}
.dc-av{position:relative;width:52px;height:52px;flex-shrink:0;}
.dc-av img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:1.5px solid rgba(255,255,255,.1);transition:transform .3s;}
.dc-av:hover img{transform:scale(1.08);}
.dc-st{position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-radius:50%;border:2.5px solid var(--bg2);transition:background .4s,box-shadow .4s;}
.online-pulse{animation:pulseGlow 2.5s infinite;}
@keyframes pulseGlow{0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}50%{box-shadow:0 0 0 5px rgba(16,185,129,0)}}
.dc-info{flex:1;min-width:0;}
.dc-name{font-weight:700;font-size:.95rem;display:flex;align-items:center;gap:6px;}
.dc-check{width:14px;height:14px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--p),var(--c));display:inline-flex;align-items:center;justify-content:center;font-size:8px;color:#fff;font-weight:900;}
.dc-sub{font-size:.76rem;color:var(--tx3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.dc-actions{display:flex;flex-direction:column;align-items:flex-end;gap:.4rem;flex-shrink:0;}
.dc-link{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;color:var(--tx3);text-decoration:none;border:1px solid var(--border);padding:.2rem .6rem;border-radius:999px;transition:all .2s;}
.dc-link:hover{color:var(--tx);border-color:var(--border-h);background:rgba(124,58,237,.12);}
.dc-status-badge{font-size:.66rem;font-weight:700;padding:.15rem .55rem;border-radius:999px;border:1px solid;transition:all .3s;}
.dc-activity{margin-top:.9rem;padding-top:.9rem;border-top:1px solid var(--border);display:flex;align-items:center;gap:.75rem;font-size:.79rem;color:var(--tx2);min-height:36px;}
.dc-activity-album{width:38px;height:38px;border-radius:7px;flex-shrink:0;overflow:hidden;border:1px solid rgba(255,255,255,.1);display:none;box-shadow:0 4px 16px rgba(0,0,0,.4);}
.dc-activity-album img{width:100%;height:100%;object-fit:cover;}
.dc-activity-text em{font-style:normal;color:var(--c2);font-weight:500;}
.sp-progress{margin-top:.7rem;position:relative;height:2px;background:rgba(255,255,255,.08);border-radius:2px;overflow:hidden;display:none;}
.sp-bar{height:100%;background:linear-gradient(90deg,#1DB954,#1ed760);border-radius:2px;transition:width .4s linear;position:relative;}
.sp-bar::after{content:'';position:absolute;right:0;top:-3px;width:8px;height:8px;border-radius:50%;background:#1DB954;box-shadow:0 0 8px #1DB954;}
.dc-album-hero{display:none;width:46px;height:46px;border-radius:9px;overflow:hidden;border:1px solid rgba(255,255,255,.1);flex-shrink:0;box-shadow:0 4px 20px rgba(0,0,0,.5);animation:albumIn .4s cubic-bezier(.16,1,.3,1);}
@keyframes albumIn{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
.dc-album-hero img{width:100%;height:100%;object-fit:cover;}

/* LINKS */
.links-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border);}
.link-item{background:rgba(13,13,22,.95);display:flex;align-items:center;gap:.75rem;padding:.95rem 1.1rem;text-decoration:none;color:var(--tx);transition:all .2s;position:relative;overflow:hidden;}
.link-item::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(6,182,212,.05));opacity:0;transition:opacity .2s;}
.link-item:hover::before{opacity:1;}
.link-item:hover .link-icon{transform:scale(1.12) rotate(-5deg);}
.link-item:hover .link-arrow{transform:translate(3px,-3px);opacity:1;}
.link-icon{width:34px;height:34px;border-radius:9px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:16px;transition:transform .3s cubic-bezier(.16,1,.3,1);border:1px solid rgba(255,255,255,.07);}
.link-text{flex:1;}
.link-name{font-size:.87rem;font-weight:600;}
.link-sub{font-size:.71rem;color:var(--tx3);}
.link-arrow{font-size:.8rem;color:var(--tx3);opacity:.4;transition:all .2s;}

/* FOOTER */
.footer{text-align:center;padding:1rem 0 0;font-size:.71rem;color:var(--tx3);animation:cardIn .7s .6s cubic-bezier(.16,1,.3,1) both;}
.glow-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--g);margin-right:5px;animation:pulseGlow 2s infinite;vertical-align:middle;}

/* THEME VARIANTS */
body.theme-fire{--p:#DC2626;--p2:#F87171;--p3:#FCA5A5;--c:#F97316;--c2:#FB923C;}
body.theme-ocean{--p:#0891B2;--p2:#22D3EE;--p3:#67E8F9;--c:#6366F1;--c2:#818CF8;}
body.theme-forest{--p:#16A34A;--p2:#4ADE80;--p3:#86EFAC;--c:#CA8A04;--c2:#FDE047;}
body.theme-rose{--p:#BE185D;--p2:#F472B6;--p3:#F9A8D4;--c:#7C3AED;--c2:#C084FC;}

/* GLITCH on konami */
@keyframes glitch{
  0%{text-shadow:2px 0 var(--p2),-2px 0 var(--c);}
  20%{text-shadow:-2px 0 var(--p2),2px 0 var(--c);}
  40%{text-shadow:2px 0 var(--c),-2px 0 var(--p2);}
  60%{text-shadow:0 0 transparent;}
  80%{text-shadow:-3px 0 var(--p2),3px 0 var(--c);}
  100%{text-shadow:2px 0 var(--p2),-2px 0 var(--c);}
}
.glitching .hero-name{animation:glitch .15s infinite,shimmerText 4s ease-in-out infinite !important;}
</style>
</head>
<body>

<canvas id="stars"></canvas>
<div class="noise"></div>
<div class="scanline"></div>
<div class="blobs"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>
<div class="toast" id="toast"></div>

<main class="page">

  <!-- HERO -->
  <div class="card">
    <div class="type-strip">
      <span class="glow-dot"></span>
      <span id="typeText"></span><span class="type-cursor"></span>
    </div>
    <div class="hero-body">
      <div class="avatar-wrap">
        <div class="avatar-ring-2"></div>
        <div class="avatar-ring"></div>
        <div class="avatar-mask"></div>
        <img id="heroAvatar" src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Hydrø"/>
        <div class="status-dot" id="heroRing" style="background:var(--g)"></div>
      </div>
      <div>
        <div class="hero-name" id="heroName">Hydrø</div>
        <div class="hero-handle">@hydro.20</div>
        <div class="hero-badges">
          <span class="badge b-purple">Developer</span>
          <span class="badge b-cyan">Builder</span>
          <span class="badge b-amber">BMW</span>
          <span class="badge b-green" id="statusHeroBadge">Idle</span>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS -->
  <div class="card" style="overflow:hidden">
    <div class="stats-grid">
      <div class="stat">
        <div class="stat-num" style="color:var(--p2)"><span class="count-up" data-target="5">0</span></div>
        <div class="stat-label">Projects</div>
      </div>
      <div class="stat">
        <div class="stat-num" style="color:var(--c2)"><span class="count-up" data-target="2">0</span>y</div>
        <div class="stat-label">Coding</div>
      </div>
      <div class="stat">
        <div class="stat-num" style="color:var(--g)">24/7</div>
        <div class="stat-label">Online</div>
      </div>
      <div class="stat">
        <div class="stat-num" style="color:#F9A8D4" id="visitCount">—</div>
        <div class="stat-label">Visitors</div>
      </div>
    </div>
  </div>

  <!-- ABOUT -->
  <div class="card">
    <div class="about-inner">
      <div class="sec-label">About me</div>
      <p class="about-text">Developer & builder. I make things for the web and Discord — mostly stuff that <span>shouldn't work but does</span>. Obsessed with <span>clean UI</span>, fast APIs, and shipping things people actually use.</p>
    </div>
  </div>

  <!-- FUN THINGS -->
  <div class="card">
    <div class="fun-card-inner">
      <div class="sec-label">Fun things</div>
      <div class="fun-grid">
        <!-- shared -->
        <div class="fun-item mobile-only" id="tiltHint">
          <span class="fun-icon">📱</span>
          <div class="fun-text">Tilt me<div class="fun-label">Gyro parallax active</div></div>
